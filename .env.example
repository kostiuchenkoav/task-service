# Шаблон локальных переменных окружения для docker-compose.
#
# Скопируйте файл и задайте свои значения (файл .env в git не попадает):
#   cp .env.example .env
#
# Пароль БД:
#   openssl rand -hex 24
#
# Ключ API (сам ключ передаёте клиенту, в .env — только его SHA-256):
#   KEY=$(openssl rand -hex 32); echo "$KEY"                 # ключ клиенту
#   printf '%s' "$KEY" | sha256sum | cut -d' ' -f1          # это в API_KEY_SHA256
#
# docker-compose намеренно отказывается стартовать без обоих значений.

POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=

# Имя клиента для журнала (не секрет)
API_KEY_ID=local
# SHA-256 от API-ключа, 64 hex-символа
API_KEY_SHA256=
