# Шаблон локальных переменных окружения для docker-compose.
#
# Скопируйте файл и задайте свой пароль (файл .env в git не попадает):
#   cp .env.example .env
#   openssl rand -hex 24        # сгенерировать стойкий пароль
#
# docker-compose намеренно отказывается стартовать с пустым паролем.

POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=
